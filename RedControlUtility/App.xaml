<Application
    x:Class="RedControlUtility.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wui="using:Windows.UI"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" />
                <ResourceDictionary x:Key="Light" />
            </ResourceDictionary.ThemeDictionaries>

            <wui:Color x:Key="SystemAccentColor">#E5252A</wui:Color>
            <wui:Color x:Key="SystemAccentColorLight1">#FF5A5F</wui:Color>
            <wui:Color x:Key="SystemAccentColorLight2">#FF7A7E</wui:Color>
            <wui:Color x:Key="SystemAccentColorLight3">#FF9A9D</wui:Color>
            <wui:Color x:Key="SystemAccentColorDark1">#C21B20</wui:Color>
            <wui:Color x:Key="SystemAccentColorDark2">#9E1418</wui:Color>
            <wui:Color x:Key="SystemAccentColorDark3">#7A0F12</wui:Color>

            <SolidColorBrush x:Key="AppAccentText" Color="#FF5A5F" />
            <SolidColorBrush x:Key="CurveLineBrush" Color="#FF5A5F" />
            <SolidColorBrush x:Key="CurveGhostBrush" Color="#96AFAFBE" />
            <SolidColorBrush x:Key="CurvePointStrokeBrush" Color="#E5252A" />
            <SolidColorBrush x:Key="CurvePointFillBrush" Color="White" />
            <SolidColorBrush x:Key="CurveMarqueeBrush" Color="#28FF5A5F" />
            <SolidColorBrush x:Key="CurveMarqueeStrokeBrush" Color="#DCFF5A5F" />
            <SolidColorBrush x:Key="CurveGridBrush" Color="#26FFFFFF" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Thickness x:Key="ToggleSwitchTopHeaderMargin">0,0,0,2</Thickness>
            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
