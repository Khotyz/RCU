<Page
    x:Class="RedControlUtility.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rcu="using:RedControlUtility"
    xmlns:models="using:RedControlUtility.Models">
    <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" rcu:Loc.Key="Dashboard.Title" />


            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="GpuNameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="GpuArchText" Foreground="{ThemeResource SystemAccentColorLight1}" FontSize="15" />
                    <Grid x:Name="InfoGrid" ColumnSpacing="24" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="PresetCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Presets.Title" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Tag="SafeUndervolt" Click="Preset_Click" rcu:Loc.Key="Presets.SafeUndervolt" />
                        <Button Tag="Quiet" Click="Preset_Click" rcu:Loc.Key="Presets.Quiet" />
                        <Button Tag="Balanced" Click="Preset_Click" rcu:Loc.Key="Presets.Balanced" />
                        <Button Tag="Performance" Click="Preset_Click" rcu:Loc.Key="Presets.Performance" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Dashboard.LiveStats" />
            <GridView x:Name="TilesView" SelectionMode="None" IsItemClickEnabled="False">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:StatTile">
                        <Border Style="{StaticResource CardStyle}" Width="200" Padding="12" ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Unit}" VerticalAlignment="Bottom" Opacity="0.7" Margin="0,0,0,4" />
                                </StackPanel>
                                <ProgressBar Value="{x:Bind Fraction, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Dashboard.ActiveApp" />
                    <TextBlock x:Name="ActiveAppText" />
                </StackPanel>
            </Border>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" rcu:Loc.Header="Dashboard.Diagnostics">
                <StackPanel Spacing="8">
                    <TextBox x:Name="DiagBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="200" MaxHeight="360"
                             FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="CopyDiag_Click" rcu:Loc.Key="Dashboard.CopyDiag" />
                        <Button Click="OpenLogs_Click" rcu:Loc.Key="Dashboard.OpenLogs" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
        </Grid>
    </ScrollViewer>
    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" VerticalAlignment="Bottom" HorizontalAlignment="Center"
             MaxWidth="720" Margin="16,0,16,12" />
    </Grid>
</Page>
