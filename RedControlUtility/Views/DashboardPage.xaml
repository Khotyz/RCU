<Page
    x:Class="RedControlUtility.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rcu="using:RedControlUtility"
    xmlns:models="using:RedControlUtility.Models"
    xmlns:ctl="using:RedControlUtility.Controls">
    <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource PageTitleStyle}" rcu:Loc.Key="Dashboard.Title" />


            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="GpuNameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="GpuArchText" Foreground="{ThemeResource SystemAccentColorLight1}" FontSize="15" />
                    <Grid x:Name="InfoGrid" ColumnSpacing="24" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="PresetCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Presets.Title" />
                    <ctl:WrapPanel>
                        <Button Tag="SafeUndervolt" Click="Preset_Click" rcu:Loc.Key="Presets.SafeUndervolt" />
                        <Button Tag="Quiet" Click="Preset_Click" rcu:Loc.Key="Presets.Quiet" />
                        <Button Tag="Balanced" Click="Preset_Click" rcu:Loc.Key="Presets.Balanced" />
                        <Button Tag="Performance" Click="Preset_Click" rcu:Loc.Key="Presets.Performance" />
                    </ctl:WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Dashboard.LiveStats" />
            <GridView x:Name="TilesView" SelectionMode="None" IsItemClickEnabled="False">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:StatTile">
                        <Border Style="{StaticResource CardStyle}" Width="168" Padding="10,8" ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Unit}" VerticalAlignment="Bottom" Opacity="0.7" Margin="0,0,0,4" />
                                </StackPanel>
                                <ProgressBar Value="{x:Bind Fraction, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="History.Title" />
                        <TextBlock x:Name="HistoryWindowText" HorizontalAlignment="Right" Opacity="0.6" FontSize="12" />
                    </Grid>
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ctl:HistoryChart x:Name="UsageChart" Series="0" Unit="%" FixedMax="100" />
                        <ctl:HistoryChart x:Name="TempChart" Grid.Column="1" Series="1" Unit="°C" />
                        <ctl:HistoryChart x:Name="PowerChart" Grid.Row="1" Series="2" Unit="W" />
                        <ctl:HistoryChart x:Name="FanChart" Grid.Row="1" Grid.Column="1" Series="3" Unit="RPM" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Dashboard.ActiveApp" />
                    <TextBlock x:Name="ActiveAppText" />
                </StackPanel>
            </Border>

        </StackPanel>
        </Grid>
    </ScrollViewer>
    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" VerticalAlignment="Bottom" HorizontalAlignment="Center"
             MaxWidth="720" Margin="16,0,16,12" />
    </Grid>
</Page>
