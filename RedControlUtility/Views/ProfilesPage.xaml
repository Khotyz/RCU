<Page
    x:Class="RedControlUtility.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rcu="using:RedControlUtility">
    <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="900" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource PageTitleStyle}" rcu:Loc.Key="Profiles.Title" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBox x:Name="NameBox" Width="360" HorizontalAlignment="Left" rcu:Loc.Header="Profiles.Name" TextChanged="NameBox_TextChanged" />
                    <TextBlock x:Name="SummaryText" Opacity="0.75" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" rcu:Loc.Key="Profiles.ApplyNow" />
                        <Button Click="Capture_Click" rcu:Loc.Key="Profiles.Capture" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Profiles.Files" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Export_Click" rcu:Loc.Key="Profiles.Export" />
                        <Button Click="Import_Click" rcu:Loc.Key="Profiles.Import" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" rcu:Loc.Key="Profiles.Reset" />
                    <Button Click="ResetColor_Click" rcu:Loc.Key="Profiles.ResetColor" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" VerticalAlignment="Bottom" HorizontalAlignment="Center"
             MaxWidth="720" Margin="16,0,16,12" />
    </Grid>
</Page>
