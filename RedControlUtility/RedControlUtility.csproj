<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RedControlUtility</RootNamespace>
    <AssemblyName>RedControlUtility</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained by default: the PC does not need .NET or the Windows App Runtime (fixes
         "Required components of the Windows App Runtime are missing, Version 1.8"). -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Red Control Utility</Product>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.2.3</Version>
    <!-- Only keep English and Portuguese (Brazil) language resources -->
    <SatelliteResourceLanguages>en-US;pt-BR</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <Link>AppIcon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="locales\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="native\RedAdlxHelper.dll" Condition="Exists('native\RedAdlxHelper.dll')">
      <Link>RedAdlxHelper.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The app only ships in en-US and pt-BR. Drop the ~150 other language folders (Windows App SDK / WinUI MUI
       resources) from the publish list and from the publish folder. Non-language folders (locales, native,
       Assets, Microsoft.*) are never matched because the pattern only matches culture names like "fr-FR". -->
  <PropertyGroup>
    <RcuLangFolderPattern>^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$</RcuLangFolderPattern>
    <RcuKeepLangPattern>^(en|en-US|pt|pt-BR)$</RcuKeepLangPattern>
  </PropertyGroup>

  <Target Name="RcuTrimLanguagesFromPublishList" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_RcuDrop Include="@(ResolvedFileToPublish)"
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*[\\/]')) And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^(en|en-US|pt|pt-BR)[\\/]', System.Text.RegularExpressions.RegexOptions.IgnoreCase))" />
      <ResolvedFileToPublish Remove="@(_RcuDrop)" />
    </ItemGroup>
  </Target>

  <Target Name="RcuTrimLanguagesFromPublishDir" AfterTargets="Publish" Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)')">
    <ItemGroup>
      <_RcuDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <_RcuDirsDrop Include="@(_RcuDirs)"
                    Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RcuDirs.Filename)%(_RcuDirs.Extension)', '$(RcuLangFolderPattern)')) And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RcuDirs.Filename)%(_RcuDirs.Extension)', '$(RcuKeepLangPattern)', System.Text.RegularExpressions.RegexOptions.IgnoreCase))" />
    </ItemGroup>
    <RemoveDir Directories="@(_RcuDirsDrop)" />
  </Target>
</Project>
