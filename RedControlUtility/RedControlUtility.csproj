<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RedControlUtility</RootNamespace>
    <AssemblyName>RedControlUtility</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <RcuBuildInstaller Condition="'$(RcuBuildInstaller)' == ''">true</RcuBuildInstaller>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Red Control Utility</Product>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.2.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en;en-US;pt;pt-BR;es;es-ES;zh;zh-CN;zh-Hans;zh-Hans-CN</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <Link>AppIcon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="locales\en-US.json;locales\pt-BR.json;locales\es-ES.json;locales\zh-CN.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="native\RedAdlxHelper.dll" Condition="Exists('native\RedAdlxHelper.dll')">
      <Link>RedAdlxHelper.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <RcuCultureFolder>^(?i:[a-z]{2,3}(?:-[a-z0-9]{2,8})*)$</RcuCultureFolder>
    <RcuIncludedCultureFolder>^(?i:$(SatelliteResourceLanguages.Replace(';', '|')))$</RcuIncludedCultureFolder>
  </PropertyGroup>

  <Target Name="TrimPublishedCultures" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_RcuPublishPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_RcuPublishPath>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_RcuPublishPath)')">
      <_RcuPublishedDirectory Include="$([System.IO.Directory]::GetDirectories('$(_RcuPublishPath)'))" />
      <_RcuExcludedDirectory Include="@(_RcuPublishedDirectory)"
                             Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RcuPublishedDirectory.Filename)%(_RcuPublishedDirectory.Extension)', '$(RcuCultureFolder)')) And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RcuPublishedDirectory.Filename)%(_RcuPublishedDirectory.Extension)', '$(RcuIncludedCultureFolder)'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_RcuExcludedDirectory)" />
  </Target>

  <Target Name="BuildInstaller" AfterTargets="TrimPublishedCultures" Condition="'$(RcuBuildInstaller)' == 'true' And '$(OS)' == 'Windows_NT' And '$(PublishDir)' != ''">
    <PropertyGroup>
      <_RcuSolutionDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))\</_RcuSolutionDir>
      <_RcuIscc>$(ProgramFiles)\Inno Setup 6\ISCC.exe</_RcuIscc>
      <_RcuIscc Condition="!Exists('$(_RcuIscc)')">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Inno Setup 6_is1', 'InstallLocation', null, RegistryView.Registry32))ISCC.exe</_RcuIscc>
      <_RcuIscc Condition="!Exists('$(_RcuIscc)')">$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe</_RcuIscc>
    </PropertyGroup>
    <Exec Condition="!Exists('$(_RcuSolutionDir)installer\redist\vc_redist.x64.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RcuSolutionDir)installer\get-redist.ps1&quot;"
          ContinueOnError="true" IgnoreExitCode="true" />
    <Warning Condition="!Exists('$(_RcuIscc)')" Text="Inno Setup 6 was not found, so the installer was not built. Install it from https://jrsoftware.org/isdl.php and publish again." />
    <Exec Condition="Exists('$(_RcuIscc)')"
          Command="&quot;$(_RcuIscc)&quot; &quot;/DSourceDir=$(_RcuPublishPath.TrimEnd('\'))&quot; &quot;$(_RcuSolutionDir)installer\RCU.iss&quot;" />
  </Target>
</Project>
